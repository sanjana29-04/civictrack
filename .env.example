# CivicTrack 2.0 Environment Configuration Template
# Copy this file to .env and adjust values for production deployment

# ==========================================
# Application & Profiles
# ==========================================
SPRING_PROFILES_ACTIVE=dev
# Options: 'dev' (uses zero-dependency file H2 with Postgres mode) or 'postgres' (connects to real PostgreSQL/PostGIS)
SERVER_PORT=8080

# ==========================================
# Database Configuration (for 'postgres' profile)
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civictrack
SPRING_DATASOURCE_USERNAME=civictrack
SPRING_DATASOURCE_PASSWORD=civictrack_secret

# ==========================================
# Security & JWT Authentication
# ==========================================
# Secret key MUST be at least 32 characters (256 bits)
CIVICTRACK_JWT_SECRET=superSecretKeyForCivicTrack2024LongEnough32BytesMinimum!
# Expiration in milliseconds (86400000 = 24 hours)
CIVICTRACK_JWT_EXPIRATION_MS=86400000

# ==========================================
# File Upload & Media Storage
# ==========================================
CIVICTRACK_STORAGE_UPLOAD_DIR=./uploads
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=15MB

# ==========================================
# AI Provider Configuration (Optional)
# ==========================================
# Leave blank or set to 'deterministic' to use zero-cost built-in heuristic NLP classifier
AI_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_STORAGE_BASE_URL=http://localhost:8080
